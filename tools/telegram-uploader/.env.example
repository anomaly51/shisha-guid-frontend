# Copy to .env and fill from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Telethon may ask for the phone during login if omitted.
TELEGRAM_PHONE=

# Defaults used by docker-compose.telegram.yml.
TELEGRAM_SESSION=/data/telegram-user
TELEGRAM_SOURCE=/photos
TELEGRAM_TARGET=photochi43322
TELEGRAM_STATE=/data/photochi43322.state.json
TELEGRAM_SLEEP=0.5
